# Copy to .env for local Flask work. Add the same names in Vercel Environment Variables.
# All credentials are server-only. Nothing in this file is sent to the browser.
SUPABASE_URL=
# Preferred sb_publishable_... key; the legacy anon JWT also works.
SUPABASE_PUBLISHABLE_KEY=
# Preferred sb_secret_... server key; a legacy service_role JWT also works.
SUPABASE_SERVICE_ROLE_KEY=
# Exact HTTPS production origin. Use this local origin for development.
SITE_URL=http://localhost:3000
# At least 32 characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep the same value across Vercel instances; it signs the PKCE callback cookie.
APP_SECRET_KEY=

# COD becomes available when database, keys and application secret are configured.
PAYMENT_COD_ENABLED=true
# Transfer stays disabled until all three fields are present; staff verify actual receipt.
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=

# Use matching Stripe test keys and webhook secret until merchant verification is complete.
# Register /api/webhooks/stripe for completed, async_payment_succeeded,
# async_payment_failed and expired checkout.session events.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_CARD_ENABLED=true
# Optional Stripe payment method configuration (pmc_...) for cards and eligible wallets.
STRIPE_CARD_CONFIGURATION_ID=
# Enable PromptPay in Stripe, create its configuration, then set these. THB only.
PAYMENT_PROMPTPAY_ENABLED=false
STRIPE_PROMPTPAY_CONFIGURATION_ID=

# Optional /api/health readiness diagnostics bearer token. Public health has no secrets.
HEALTHCHECK_SECRET=
# Optional local listening port; python app.py defaults to 3000.
PORT=3000
